{
  "name": "@capgo/capacitor-firebase-performance",
  "version": "8.6.1",
  "description": "Capacitor plugin for Firebase Performance Monitoring on Android, iOS, and Web.",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Plugin/",
    "CapgoCapacitorFirebasePerformance.podspec",
    "Package.swift"
  ],
  "author": "Capgo Team",
  "license": "MPL-2.0",
  "homepage": "https://capgo.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cap-go/capacitor-firebase.git"
  },
  "bugs": {
    "url": "https://github.com/Cap-go/capacitor-firebase/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "capacitor-plugin",
    "firebase",
    "firebase performance",
    "performance monitoring",
    "app performance",
    "tracing",
    "custom traces",
    "metrics"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "cd ios && pod install && xcodebuild -workspace Plugin.xcworkspace -scheme Plugin -destination generic/platform=iOS && cd ..",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build && npm run check:esm-package",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\"",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --project tsconfig.docgen.json --api FirebasePerformancePlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run check:esm-imports && npm run clean && npm run docgen && tsc",
    "check:esm-imports": "node scripts/check-esm-imports.mjs",
    "check:esm-package": "node scripts/check-esm-package.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "ios:pod:install": "cd ios && pod install --repo-update && cd ..",
    "ios:spm:install": "cd ios && swift package resolve && cd ..",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@capacitor/android": "8.0.0",
    "@capacitor/cli": "8.0.0",
    "@capacitor/core": "8.0.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "8.0.0",
    "@ionic/eslint-config": "0.4.0",
    "eslint": "8.57.0",
    "firebase": "12.6.0",
    "prettier-plugin-java": "2.6.7",
    "rimraf": "6.1.2",
    "swiftlint": "2.0.0",
    "typescript": "5.9.3",
    "prettier": "3.4.2"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0",
    "firebase": "^12.6.0"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    }
  },
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
