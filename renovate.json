{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Cap-go/.github:renovate-config"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "eslint"
      ],
      "matchManagers": [
        "npm"
      ],
      "enabled": false
    },
    {
      "groupName": "Firebase SDK",
      "matchPackageNames": [
        "firebase"
      ],
      "matchPackagePatterns": [
        "^com\\.google\\.firebase.*",
        "^Firebase.*"
      ],
      "matchManagers": [
        "npm",
        "gradle",
        "cocoapods",
        "swift-pm"
      ],
      "automerge": true,
      "automergeType": "branch",
      "platformAutomerge": true,
      "schedule": [
        "at any time"
      ],
      "minimumReleaseAge": "0 days",
      "updatePinnedDependencies": true,
      "rangeStrategy": "bump",
      "semanticCommits": "disabled",
      "commitMessagePrefix": "chore(firebase): ",
      "commitMessageAction": "update",
      "commitMessageTopic": "Firebase SDK"
    },
    {
      "matchManagers": [
        "swift-pm"
      ],
      "matchPackagePatterns": [
        "^https://github.com/ionic-team/capacitor-swift-pm\\.git$",
        "^ionic-team/capacitor-swift-pm$",
        "^capacitor-swift-pm$"
      ],
      "allowedVersions": "8.0.0",
      "enabled": false
    }
  ]
}
